<?xml version="1.0" encoding="utf-8"?>
<!--
  MVP endless-runner racing screen:
  - A simple "road" view with lane markers (pure Canvas drawing, no images required)
  - Speed HUD (km/h) + small status text (throttle/brake/coast)
  - Throttle and Brake controls (press & hold)
  - Reset button to quickly restart the run

  Why XML + Views:
  - Project constraint: non-Compose
  - Minimal dependencies and easy to understand for an MVP
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:padding="16dp">

    <com.example.simplecalculator.game.RoadView
        android:id="@+id/roadView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/cd_road_view"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/controlPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- HUD container: speed + state -->
    <LinearLayout
        android:id="@+id/hud"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toTopOf="@id/roadView"
        app:layout_constraintStart_toStartOf="@id/roadView"
        app:layout_constraintEnd_toEndOf="@id/roadView">

        <TextView
            android:id="@+id/speedText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/speed_placeholder"
            android:textColor="@color/black"
            android:textSize="22sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/stateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/state_placeholder"
            android:textColor="@color/black"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Controls panel -->
    <LinearLayout
        android:id="@+id/controlPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/buttonRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3">

            <Button
                android:id="@+id/btnBrake"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="@string/brake"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnThrottle"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="@string/throttle"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnReset"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="@string/reset"
                android:textAllCaps="false" />
        </LinearLayout>

        <TextView
            android:id="@+id/helpText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/help_controls"
            android:textColor="@color/black"
            android:textSize="12sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
