<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      Light theme as requested; keeps UI minimal.
      Using MaterialComponents base theme for consistent widgets styling.
    -->
    <style name="Theme.SimpleCalculator" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorSecondary">@color/teal_200</item>

        <!-- Ensure default background matches the work item requirement. -->
        <item name="android:windowBackground">@color/white</item>
    </style>
</resources>
