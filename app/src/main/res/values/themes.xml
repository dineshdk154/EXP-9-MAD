<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      DayNight theme to support dark mode toggle.
      Still minimal: no ActionBar, MaterialComponents widgets.
    -->
    <style name="Theme.SimpleCalculator" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorSecondary">@color/teal_200</item>

        <!-- Use theme-provided surfaces; works for light & dark automatically. -->
        <item name="android:windowBackground">?attr/colorSurface</item>
    </style>
</resources>
